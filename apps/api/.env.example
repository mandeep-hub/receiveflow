# ReceiveFlow API settings. Copy to .env and fill in; never commit .env.

# PostgreSQL connection for the API (required).
DATABASE_URL=

# "production" turns on Secure "__Host-" session cookies and requires an
# https FRONTEND_ORIGIN. Leave unset for local development. The API refuses to
# start with an https FRONTEND_ORIGIN unless this is "production".
NODE_ENV=

# The one browser origin allowed to call the API with session cookies,
# e.g. https://app.example.com (scheme, host, optional port; no path).
# Development default: http://localhost:5173
FRONTEND_ORIGIN=

# Number of reverse proxies in front of the API (default 0), so the client
# address used for login rate limiting is correct.
TRUST_PROXY=

# The port the API listens on, a whole number from 1 to 65535 (default 3000).
PORT=
