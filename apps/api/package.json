{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "create-admin": "tsx src/scripts/create-admin.ts",
    "test": "node --import tsx --import ./test/guard.ts --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "test:unit": "node --import tsx --test --test-concurrency=1 test/guard.test.ts \"test/unit/**/*.test.ts\""
  },
  "license": "MIT",
  "dependencies": {
    "argon2": "0.45.1",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
