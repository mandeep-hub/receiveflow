generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PurchaseOrderStatus {
  DRAFT
  OPEN
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PurchaseOrderSource {
  MANUAL
  EXCEL
  QLIK
}

model Supplier {
  id     Int     @id @default(autoincrement())
  code   String  @unique
  name   String
  active Boolean @default(true)

  purchaseOrders PurchaseOrder[]
}

model Product {
  id            Int     @id @default(autoincrement())
  articleNumber String  @unique
  name          String
  active        Boolean @default(true)

  purchaseOrderItems PurchaseOrderItem[]
}

model PurchaseOrder {
  id                   Int                 @id @default(autoincrement())
  poNumber             String              @unique
  orderDate            DateTime
  expectedDeliveryDate DateTime?
  status               PurchaseOrderStatus @default(OPEN)
  source               PurchaseOrderSource @default(MANUAL)
  externalReference    String?

  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  items      PurchaseOrderItem[]
  receivings Receiving[]
}

model PurchaseOrderItem {
  id              Int @id @default(autoincrement())
  quantityOrdered Int

  purchaseOrderId Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  productId      Int
  product        Product         @relation(fields: [productId], references: [id])
  receivingItems ReceivingItem[]
}

model Receiving {
  id         Int      @id @default(autoincrement())
  receivedAt DateTime @default(now())

  purchaseOrderId Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  items ReceivingItem[]
}

model ReceivingItem {
  id               Int     @id @default(autoincrement())
  quantityReceived Int
  reasonCode       String?
  actionStatus     String?

  receivingId Int
  receiving   Receiving @relation(fields: [receivingId], references: [id], onDelete: Cascade)

  purchaseOrderItemId Int
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
}
