generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PurchaseOrderStatus {
  DRAFT
  OPEN
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PurchaseOrderSource {
  MANUAL
  EXCEL
  QLIK
}

enum UserRole {
  ADMIN
  WAREHOUSE
}

model Supplier {
  id     Int     @id @default(autoincrement())
  code   String  @unique
  name   String
  active Boolean @default(true)

  purchaseOrders PurchaseOrder[]
}

model Product {
  id            Int     @id @default(autoincrement())
  articleNumber String  @unique
  name          String
  active        Boolean @default(true)

  purchaseOrderItems PurchaseOrderItem[]
}

model PurchaseOrder {
  id                   Int                 @id @default(autoincrement())
  poNumber             String              @unique
  orderDate            DateTime
  expectedDeliveryDate DateTime?
  status               PurchaseOrderStatus @default(OPEN)
  source               PurchaseOrderSource @default(MANUAL)
  externalReference    String?

  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  items      PurchaseOrderItem[]
  receivings Receiving[]
}

model PurchaseOrderItem {
  id              Int @id @default(autoincrement())
  quantityOrdered Int

  purchaseOrderId Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  productId      Int
  product        Product         @relation(fields: [productId], references: [id])
  receivingItems ReceivingItem[]
}

model Receiving {
  id         Int      @id @default(autoincrement())
  receivedAt DateTime @default(now())

  epCount         Int
  purchaseOrderId Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  items ReceivingItem[]
}

model ReceivingItem {
  id               Int     @id @default(autoincrement())
  quantityReceived Int
  reasonCode       String?
  actionStatus     String?

  receivingId Int
  receiving   Receiving @relation(fields: [receivingId], references: [id], onDelete: Cascade)

  purchaseOrderItemId Int
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
}

model User {
  id           Int      @id @default(autoincrement())
  // Always stored trimmed and lower-cased. The migration enforces this with
  // the CHECK constraint "User_email_lowercase" (email = lower(btrim(email))),
  // which Prisma schema syntax cannot represent.
  email        String   @unique
  // Argon2id hash ("$argon2id$..."); the password itself is never stored.
  passwordHash String
  role         UserRole @default(WAREHOUSE)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions Session[]
}

model Session {
  id        Int      @id @default(autoincrement())
  // SHA-256 (hex) of the session cookie value; the cookie value is never stored.
  tokenHash String   @unique
  // Random per-session token the frontend sends in the X-CSRF-Token header.
  csrfToken String
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}
